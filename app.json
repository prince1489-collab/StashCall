{
  "expo": {
    "name": "StashCall",
    "slug": "stashcall",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.stashcall.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.stashcall.app",
      "permissions": [
        "android.permission.SCHEDULE_EXACT_ALARM"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "stashcall",
    "plugins": [
      "expo-router",
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "StashCall uses your photos so you can show which item you mean, like your own lens case or charger. Photos stay on your phone.",
          "cameraPermission": "StashCall uses the camera so you can photograph items you tend to forget. Photos stay on your phone.",
          "microphonePermission": false
        }
      ],
      "expo-notifications"
    ],
    "owner": "prince1489"
  }
}
