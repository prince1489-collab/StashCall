{
  "expo": {
    "name": "StashCall",
    "slug": "stashcall",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.stashcall.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1B2A41",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.stashcall.app",
      "permissions": [
        "android.permission.SCHEDULE_EXACT_ALARM"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "stashcall",
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#1B2A41"
        }
      ],
      [
        "expo-font",
        {}
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "StashCall uses your photos so you can show which item you mean, like your own lens case or charger. Photos stay on your phone.",
          "cameraPermission": "StashCall uses the camera so you can photograph items you tend to forget. Photos stay on your phone.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/sounds/stashcall_alarm.wav"
          ],
          "icon": "./assets/notification-icon.png",
          "color": "#E9A23B"
        }
      ],
      [
        "expo-share-intent",
        {
          "androidIntentFilters": [
            "image/*"
          ],
          "androidMultiIntentFilters": [
            "image/*"
          ],
          "disableIOS": true
        }
      ],
      "./plugins/withTextRecognitionModel"
    ],
    "owner": "prince1489",
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "b258cf9e-314b-48b3-903c-ecc131885c0e"
      },
      "supabaseUrl": "https://zuhawtlmobsdlaldajaf.supabase.co",
      "supabaseAnonKey": ""
    },
    "primaryColor": "#1B2A41"
  }
}
